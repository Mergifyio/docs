    "@babel/core": "8.0.1",
    "@biomejs/biome": "2.5.11",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@iconify-json/lucide": "1.2.127",
    "@types/hast": "3.0.5",
    "@types/html-escaper": "3.0.4",
