{
  "name": "docs",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "tsc && astro build",
    "cf-build": "./cf-build.sh",
    "test": "vitest",
    "preview": "astro preview",
    "format": "biome format --write .",
    "format:check": "biome format src integrations plugins scripts",
    "check": "astro check && eslint . && biome check .",
    "check:config-examples": "node scripts/validate-config-examples.mjs",
    "check:internal-leaks": "node scripts/check-internal-leaks.mjs",
    "check:links": "linkinator / enterprise/ --server-root dist --config linkinator.config.mjs"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@astrojs/mdx": "7.0.8",
    "@astrojs/sitemap": "3.7.3",
