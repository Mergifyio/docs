---
/**
 * A labelled row of links into the reference, e.g. "Actions: scopes
 * scopes-upload". Renders nothing for an empty list.
 */
interface Props {
  label: string;
  names: string[];
  anchor: (name: string) => string;
  class?: string;
}

const { label, names, anchor, class: className } = Astro.props;
---

{
  names.length > 0 && (
    <p class:list={['cli-arg-enum', className]}>
      <span class="gha-links-label">{label}:</span>{' '}
      {names.map((name, i) => (
        <>
          {i > 0 && ' '}
          <a href={`#${anchor(name)}`}>
            <code>{name}</code>
          </a>
        </>
      ))}
    </p>
  )
}
