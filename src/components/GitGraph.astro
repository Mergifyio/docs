---
import { instance } from '@viz-js/viz';
import { load } from 'cheerio';
import { type DiagramRole, finishDiagramSvg } from '~/util/diagramSvg';

/**
 * Commit graphs, in two modes.
 *
 * Neither mode names a colour. A call site names a *role* — the same vocabulary
 * the `dot` fences use — and `.dg` in index.css resolves it at paint time, so
 * this component and the fences share one palette and one dark mode. See
 * DESIGN.md for the roles.
 */

// ── Types ──────────────────────────────────────────────

interface PR {
  label: string;
  commits: number | [number, number];
  role?: DiagramRole;
  annotation?: string;
}

interface GraphNode {
  id: string;
  label: string;
  role?: DiagramRole;
  ghost?: boolean;
}

interface GraphEdge {
  from: string;
  to: string;
  dashed?: boolean;
  label?: string;
}

interface BranchLabel {
  label: string;
  node: string;
}

type Props =
  | {
      /** Linear mode: commit labels left to right. */
      commits: string[];
      commitRole?: DiagramRole;
      branch?: string;
      prs?: PR[];
      nodes?: never;
    }
  | {
      /** Graph mode: explicit nodes, edges, and branch labels. */
      nodes: GraphNode[];
      edges?: GraphEdge[];
      branch?: BranchLabel;
      commits?: never;
    };

// ── Rendering ──────────────────────────────────────────

const props = Astro.props;
let svgHtml: string;

if ('commits' in props && props.commits) {
  svgHtml = renderLinear(props);
} else if ('nodes' in props && props.nodes) {
  svgHtml = await renderGraph(props);
} else {
  svgHtml = '';
}

// ── Linear mode (stacks): hand-placed SVG ─────────────

function renderLinear(p: {
  commits: string[];
  commitRole?: DiagramRole;
  branch?: string;
  prs?: PR[];
}): string {
  const { commits, commitRole = 'external', branch = 'main', prs = [] } = p;

  const R = 18;
  const SPACING = 80;
  const COMMIT_Y = 32;
  const PR_Y = 100;
  const PR_H = 26;
  const PR_R = 6;
  const FONT = 11;
  const CHAR_W = 7;
  const PAD_LEFT = Math.max(70, branch.length * CHAR_W + 40);
  const PR_PAD_X = 16;
  const ANNO_GAP = 16;

  const cx = (i: number) => PAD_LEFT + i * SPACING;

  const prData = prs.map((pr) => {
    const [from, to] = Array.isArray(pr.commits) ? pr.commits : [pr.commits, pr.commits];
    const center = (cx(from) + cx(to)) / 2;
    const w = Math.max(pr.label.length * CHAR_W + PR_PAD_X, 54);
    return { ...pr, from, to, center, w, role: pr.role ?? 'config' };
  });

  const hasAnno = prData.some((pr) => pr.annotation);
  const annoY = PR_Y + PR_H / 2 + ANNO_GAP;
  const maxX = Math.max(
    cx(commits.length - 1) + R + 30,
    ...prData.map((pr) => pr.center + pr.w / 2 + 20)
  );
  const maxY = hasAnno ? annoY + 12 : PR_Y + PR_H / 2 + 12;

  const lines: string[] = [];
  const push = (s: string) => lines.push(s);

  const cssMaxW = Math.min(560, Math.max(360, maxX + 20));
  push(
    `<svg viewBox="0 0 ${maxX} ${maxY}" xmlns="http://www.w3.org/2000/svg" class="dg dg-linear" style="max-width:${cssMaxW}px" role="img">`
  );

  // branch line
  push(
    `<g class="edge ${commitRole}"><line x1="${cx(0) - 28}" y1="${COMMIT_Y}" x2="${cx(commits.length - 1)}" y2="${COMMIT_Y}" stroke-width="2" stroke-dasharray="6 4"/></g>`
  );

  // branch label — a caption, so `plain` keeps a box from appearing behind it
  push(
    `<g class="node ${commitRole} plain"><text x="${cx(0) - 34}" y="${COMMIT_Y + 4}" text-anchor="end" font-size="${FONT}" font-weight="500">${branch}</text></g>`
  );

  // commits
  for (let i = 0; i < commits.length; i++) {
    if (i < commits.length - 1) {
      push(
        `<g class="edge ${commitRole}"><line x1="${cx(i) + R}" y1="${COMMIT_Y}" x2="${cx(i + 1) - R}" y2="${COMMIT_Y}" stroke-width="2"/></g>`
      );
    }
    push(
      `<g class="node ${commitRole}"><circle cx="${cx(i)}" cy="${COMMIT_Y}" r="${R}"/>` +
        `<text x="${cx(i)}" y="${COMMIT_Y + 4}" text-anchor="middle" font-size="${FONT}" font-weight="600">${commits[i]}</text></g>`
    );
  }

  // PRs
  for (const pr of prData) {
    for (let i = pr.from; i <= pr.to; i++) {
      push(
        `<g class="edge ${pr.role}"><line x1="${cx(i)}" y1="${COMMIT_Y + R}" x2="${pr.center}" y2="${PR_Y - PR_H / 2}" stroke-width="1.5" stroke-dasharray="4 3"/></g>`
      );
    }
    push(
      `<g class="node ${pr.role}"><rect x="${pr.center - pr.w / 2}" y="${PR_Y - PR_H / 2}" width="${pr.w}" height="${PR_H}" rx="${PR_R}"/>` +
        `<text x="${pr.center}" y="${PR_Y + 4}" text-anchor="middle" font-size="${FONT}" font-weight="500">${pr.label}</text></g>`
    );
    if (pr.annotation) {
      push(
        `<g class="node ${pr.role} plain"><text x="${pr.center}" y="${annoY}" text-anchor="middle" font-size="9" font-style="italic">${pr.annotation}</text></g>`
      );
    }
  }

  push('</svg>');
  return lines.join('\n');
}

// ── Graph mode (merge strategies): Graphviz ───────────

async function renderGraph(p: {
  nodes: GraphNode[];
  edges?: GraphEdge[];
  branch?: BranchLabel;
}): Promise<string> {
  const { nodes, edges = [], branch } = p;
  const viz = await instance();

  const dot: string[] = [];
  dot.push('strict digraph {');
  dot.push('  graph [bgcolor="transparent"];');
  dot.push('  rankdir="LR";');
  dot.push('  splines=line;');
  dot.push(
    '  node [style=filled, shape=circle, fontname="Helvetica", fontsize=13, width=0.5, height=0.5, fixedsize=true, penwidth=1.6];'
  );
  dot.push('  edge [fontname="Helvetica", fontsize=10, penwidth=1.3, arrowsize=0.7];');

  // nodes
  for (const n of nodes) {
    const style = n.ghost ? ', style="filled,dashed"' : '';
    dot.push(`  ${n.id} [label="${n.label}", class="${n.role ?? 'external'}"${style}];`);
  }

  // branch label — `plain` so it reads as a caption rather than a filled box
  if (branch) {
    const role = nodes.find((n) => n.id === branch.node)?.role ?? 'external';
    dot.push(
      `  _branch [label="${branch.label}", shape=plaintext, fontsize=10, class="${role} plain"];`
    );
    dot.push(`  _branch -> ${branch.node} [style=dashed, arrowhead=none, class="${role}"];`);
    dot.push(`  { rank=same; ${branch.node}; _branch; }`);
  }

  // edges
  for (const e of edges) {
    const attrs = [`class="${e.dashed ? 'muted' : 'chrome'}"`];
    if (e.dashed) attrs.push('style=dashed');
    if (e.label) attrs.push(`label="${e.label}"`);
    dot.push(`  ${e.from} -> ${e.to} [${attrs.join(', ')}];`);
  }

  dot.push('}');

  const $ = load(viz.renderString(dot.join('\n'), { format: 'svg', engine: 'dot' }));
  $('svg').removeAttr('width').removeAttr('height');
  finishDiagramSvg($, { classes: ['dg-commits'] });
  return $.html('svg');
}
---

<Fragment set:html={svgHtml} />
